# ==========================================
# Neanderthal Environment Configuration
# ==========================================

# Google Gemini API Key (Required)
# Used for real-time streaming answers and AI unscripted prompt discovery.
# Obtain a free API key at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Optional: Custom User-Agent for Wikimedia / DuckDuckGo image resolution queries.
# If omitted, a clean generic default will be used.
# USER_AGENT=NeanderthalApp/1.0 (https://github.com/asiffisa/Neanderthal)
