# Google Gemini API Key for unscripted science exploration
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Overrides the default model (gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, but set it if you fork this. Identifies your deployment to Wikipedia
# and Wikimedia Commons, whose User-Agent policy expects a descriptive string.
# USER_AGENT=YourApp/1.0 (https://example.com/your-repo)
